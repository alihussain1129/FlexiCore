<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlexiCore.ActivationServices</AssemblyName>
    <RootNamespace>FlexiCore.ActivationEngine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FlexiCore.ActivationEngine\Services\*.cs"
             Exclude="..\FlexiCore.ActivationEngine\Services\WpfDialogService.cs"
             Link="Services\%(Filename)%(Extension)" />
    <Compile Include="..\FlexiCore.ActivationEngine\ViewModels\*.cs"
             Link="ViewModels\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlexiCore.Licensing\FlexiCore.Licensing.csproj" />
    <ProjectReference Include="..\FlexiCore.LicenseTool.Core\FlexiCore.LicenseTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
