<UserControl x:Class="FlexiCore.ActivationEngine.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlexiCore.ActivationEngine.Views">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22"/>
    <local:StatusBanner/>
    <Border Style="{StaticResource Card}">
      <ItemsControl ItemsSource="{Binding Details}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}"/>
              <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                       Background="Transparent" TextWrapping="Wrap" FontSize="14" Padding="0"
                       Foreground="{StaticResource TextBrush}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </StackPanel>
</UserControl>
