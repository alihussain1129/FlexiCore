<UserControl x:Class="FlexiCore.ActivationEngine.Views.PageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Opacity="0">
  <UserControl.RenderTransform>
    <TranslateTransform Y="14"/>
  </UserControl.RenderTransform>
  <UserControl.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28"/>
          <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="14" To="0" Duration="0:0:0.28">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </UserControl.Triggers>

  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,26"/>

    <Border Style="{StaticResource Card}" Padding="40"
            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" MaxWidth="480">
        <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                Background="{StaticResource AccentSoftBrush}">
          <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="26"
                     Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding EmptyTitle}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
        <TextBlock Text="{Binding EmptyDetail}" Style="{StaticResource BodyMuted}"
                   TextAlignment="Center" LineHeight="22"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}"
            Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
      <ItemsControl ItemsSource="{Binding Details}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}"/>
              <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="14"
                         Foreground="{StaticResource TextBrush}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </StackPanel>
</UserControl>
