<UserControl x:Class="FlexiCore.ActivationEngine.Views.LedgerPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlexiCore.ActivationEngine.Views">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22"/>
    <local:StatusBanner/>

    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
      <TextBlock Text="{Binding Note}" Style="{StaticResource BodyMuted}" Foreground="{StaticResource TextBrush}"/>
    </Border>

    <Border Style="{StaticResource Card}" Padding="40" Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" MaxWidth="480">
        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="30"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Nothing recorded yet" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center" Margin="0,14,0,6"/>
        <TextBlock Text="Issue a license and it will be recorded in the issue ledger on this computer."
                   Style="{StaticResource BodyMuted}" TextAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border Padding="22">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasNoRows}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid><TextBox Style="{StaticResource InputBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Search records" ToolTip="Search by license id, customer or key id"/><TextBlock Text="Search by license ID, customer or key" IsHitTestVisible="False" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource BodyMuted}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Rows}" MaxHeight="520"
                  AutomationProperties.Name="Ledger records" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="License ID" Binding="{Binding LicenseId, Mode=OneWay}" Width="160" MinWidth="160"/>
            <DataGridTextColumn Header="Customer" Binding="{Binding Licensee, Mode=OneWay}" Width="*" MinWidth="180"/>
            <DataGridTextColumn Header="Key" Binding="{Binding KeyId, Mode=OneWay}" Width="110" MinWidth="110"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="110" MinWidth="110"/>
            <DataGridTextColumn Header="Valid from" Binding="{Binding NotBefore, Mode=OneWay}" Width="160" MinWidth="160"/>
            <DataGridTextColumn Header="Expires" Binding="{Binding Expires, Mode=OneWay}" Width="160" MinWidth="160"/>
            <DataGridTextColumn Header="Grace" Binding="{Binding Grace, Mode=OneWay}" Width="80" MinWidth="80"/>
            <DataGridTextColumn Header="Installs" Binding="{Binding Installations, Mode=OneWay}" Width="90" MinWidth="90"/>
            <DataGridTextColumn Header="Recorded" Binding="{Binding Recorded, Mode=OneWay}" Width="160" MinWidth="160"/>
            <DataGridTextColumn Header="File hash" Binding="{Binding FileSha256, Mode=OneWay}" Width="150" MinWidth="150"/>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
