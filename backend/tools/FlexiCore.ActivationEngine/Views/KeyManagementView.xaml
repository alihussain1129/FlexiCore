<UserControl x:Class="FlexiCore.ActivationEngine.Views.KeyManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlexiCore.ActivationEngine.Views">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22"/>
    <local:StatusBanner/>

    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
      <TextBlock Style="{StaticResource BodyMuted}" Foreground="{StaticResource TextBrush}"
                 Text="The Engine picks the signing key for you: the newest active key that is built into the ERP. A retired key never signs again, but the ERP still trusts it, so licenses it already signed keep working. Remove a retired key from the ERP only when its row says Yes under Remove from ERP. A new key cannot sign until its public key is in the ERP key file and the ERP has been rebuilt."/>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="ERP key file" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,0,0,12"
                   Text="This is the list of public keys built into the ERP. The Engine compares every key with it, so it never signs with a key the ERP would refuse."/>
        <TextBox Style="{StaticResource ReadOnlyBox}" Text="{Binding ErpFileText, Mode=OneWay}" Margin="0,0,0,12"
                 AutomationProperties.Name="ERP key file"/>
        <WrapPanel>
          <Button Content="Check ERP key file" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,8"/>
          <Button Content="Choose file..." Style="{StaticResource SecondaryButton}" Command="{Binding ChooseErpFileCommand}" Margin="0,0,10,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Signing keys and what each one has signed" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
        <TextBlock Text="No signing keys yet. Create one below." Style="{StaticResource BodyMuted}" Margin="0,0,0,12"
                   Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}"/>
        <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  MaxHeight="300" AutomationProperties.Name="Signing keys">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Key ID" Binding="{Binding KeyId, Mode=OneWay}" Width="120"/>
            <DataGridTextColumn Header="State" Binding="{Binding State, Mode=OneWay}" Width="150"/>
            <DataGridTextColumn Header="Created" Binding="{Binding Created, Mode=OneWay}" Width="180"/>
            <DataGridTextColumn Header="Signed" Binding="{Binding Licenses, Mode=OneWay}" Width="80"/>
            <DataGridTextColumn Header="Last used" Binding="{Binding LastUsed, Mode=OneWay}" Width="180"/>
            <DataGridTextColumn Header="Not expired" Binding="{Binding NotExpired, Mode=OneWay}" Width="100"/>
            <DataGridTextColumn Header="In ERP file" Binding="{Binding InErp, Mode=OneWay}" Width="90"/>
            <DataGridTextColumn Header="Remove from ERP" Binding="{Binding RemoveFromErp, Mode=OneWay}" Width="140"/>
            <DataGridTextColumn Header="Advice" Binding="{Binding Advice, Mode=OneWay}" Width="*" MinWidth="220"/>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,14,0,0">
          <Button Content="Retire selected" Style="{StaticResource SecondaryButton}" Command="{Binding RetireCommand}" Margin="0,0,10,8"/>
          <Button Content="Reactivate selected" Style="{StaticResource SecondaryButton}" Command="{Binding ReactivateCommand}" Margin="0,0,10,8"/>
          <Button Content="Mark as built into ERP" Style="{StaticResource SecondaryButton}" Command="{Binding MarkInErpCommand}" Margin="0,0,10,8"/>
          <Button Content="Copy public key entry" Style="{StaticResource SecondaryButton}" Click="OnCopySnippetClick" Margin="0,0,10,8"
                  ToolTip="Copies the JSON entry to paste into production-public-keys.json"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Rotate: create the next key" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,0,0,14"
                   Text="The Engine picks the next unused key id. The new key is not used for signing until its public key is in the ERP key file. The passphrase is never saved and cannot be recovered."/>
        <TextBlock Text="Next key id" Style="{StaticResource FieldLabel}"/>
        <TextBox Style="{StaticResource ReadOnlyBox}" Text="{Binding SuggestedKeyId, Mode=OneWay}" Margin="0,0,0,12"
                 AutomationProperties.Name="Next key id"/>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Passphrase (at least 16 characters)" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="NewPass" Style="{StaticResource InputPassword}" AutomationProperties.Name="New key passphrase"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Repeat passphrase" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="NewPassConfirm" Style="{StaticResource InputPassword}" AutomationProperties.Name="Repeat passphrase"/>
          </StackPanel>
        </Grid>
        <Button Content="Create new key" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                IsEnabled="{Binding IsNotBusy}" Click="OnCreateClick"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Key management history" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
        <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Events}" MaxHeight="260"
                  AutomationProperties.Name="Key management history">
          <DataGrid.Columns>
            <DataGridTextColumn Header="When" Binding="{Binding When, Mode=OneWay}" Width="160"/>
            <DataGridTextColumn Header="Key" Binding="{Binding KeyId, Mode=OneWay}" Width="130"/>
            <DataGridTextColumn Header="Action" Binding="{Binding Action, Mode=OneWay}" Width="140"/>
            <DataGridTextColumn Header="Detail" Binding="{Binding Detail, Mode=OneWay}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>