<UserControl x:Class="FlexiCore.ActivationEngine.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlexiCore.ActivationEngine.Views">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22"/>
    <local:StatusBanner/>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="Key folder" Style="{StaticResource FieldLabel}"/>
        <TextBox Style="{StaticResource ReadOnlyBox}" Text="{Binding KeyFolder, Mode=OneWay}" Margin="0,0,0,14"
                 AutomationProperties.Name="Key folder"/>
        <WrapPanel>
          <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,8"/>
          <Button Content="Open folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,10,8"/>
          <Button Content="Export selected public key..." Style="{StaticResource PrimaryButton}" Command="{Binding ExportSelectedCommand}" Margin="0,0,10,8"/>
          <Button Content="Export all public keys..." Style="{StaticResource SecondaryButton}" Command="{Binding ExportAllCommand}" Margin="0,0,10,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="36"
            Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" MaxWidth="480">
        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="30"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="No signing keys" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center" Margin="0,14,0,6"/>
        <TextBlock Text="Licenses cannot be issued until a key exists. Create one below."
                   Style="{StaticResource BodyMuted}" TextAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border Padding="22" Margin="0,0,0,16">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasNoRows}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  MaxHeight="300" AutomationProperties.Name="Signing keys">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Key ID" Binding="{Binding KeyId, Mode=OneWay}" Width="160"/>
            <DataGridTextColumn Header="Public fingerprint" Binding="{Binding FingerprintShort, Mode=OneWay}" Width="300"/>
            <DataGridTextColumn Header="Created" Binding="{Binding Created, Mode=OneWay}" Width="160"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Full fingerprint of the selected key" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
        <TextBox Style="{StaticResource ReadOnlyBox}" Text="{Binding SelectedFingerprint, Mode=OneWay}"
                 AutomationProperties.Name="Selected key fingerprint"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="Create a signing key" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,0,0,16"
                   Text="This creates a real encrypted signing key in the key folder. The next unused id is filled in for you, and every key is recorded in the Key Management history. A new key is not used for signing until its public key is in the ERP key file. While testing, type an id such as dev-test-1 instead and never give its public key file to a customer. An existing key is never replaced. Passphrase: at least 16 characters; it cannot be recovered."/>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Key ID (filled in for you; change it only for a test key)" Style="{StaticResource FieldLabel}"/>
            <TextBox Style="{StaticResource InputBox}" Text="{Binding NewKeyId, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="New key id"/>
          </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Passphrase" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="NewPass" Style="{StaticResource InputPassword}" AutomationProperties.Name="New key passphrase"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Repeat passphrase" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="NewPassConfirm" Style="{StaticResource InputPassword}" AutomationProperties.Name="Repeat passphrase"/>
          </StackPanel>
        </Grid>
        <Button Content="Create key" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                IsEnabled="{Binding IsNotBusy}" Click="OnCreateClick"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
