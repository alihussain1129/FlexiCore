<UserControl x:Class="FlexiCore.ActivationEngine.Views.ActivateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlexiCore.ActivationEngine.Views">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22"/>
    <local:StatusBanner/>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Customer request code" Style="{StaticResource FieldLabel}"/>
          <Button Grid.Column="1" Content="Paste from clipboard" Style="{StaticResource SecondaryButton}"
                  Padding="12,5" Margin="8,0,0,4" Click="OnPasteRequestClick"/>
        </Grid>
        <TextBox x:Name="RequestCodeBox" Style="{StaticResource InputBox}" Text="{Binding RequestText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" FontFamily="Consolas"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Customer request code"/>
        <WrapPanel Margin="0,14,0,0">
          <Button Content="Verify code" Style="{StaticResource PrimaryButton}" Command="{Binding VerifyCommand}" Margin="0,0,10,8"/>
          <Button Content="Open request file..." Style="{StaticResource SecondaryButton}" Command="{Binding OpenFileCommand}" Margin="0,0,10,8"/>
          <Button Content="Use this computer (testing only)" Style="{StaticResource SecondaryButton}" Command="{Binding UseThisComputerCommand}" Margin="0,0,10,8"/>
          <Button Content="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" Margin="0,0,10,8"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding HasParsed, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <TextBlock Text="Installation found" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>
        <TextBlock Text="Installation ID" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource ReadOnlyBox}" Text="{Binding ParsedInstallationId, Mode=OneWay}"
                   TextWrapping="Wrap" MinWidth="0" AutomationProperties.Name="Installation ID"/>
          <Button Grid.Column="1" Content="Copy" Tag="{Binding ParsedInstallationId}"
                  Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="8,0,0,0"
                  VerticalAlignment="Top" Click="OnCopyValueClick"/>
        </Grid>
        <TextBlock Text="Normalized request code" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource ReadOnlyBox}" Text="{Binding ParsedRequestCode, Mode=OneWay}"
                   TextWrapping="Wrap" MinWidth="0" AutomationProperties.Name="Normalized request code"/>
          <Button Grid.Column="1" Content="Copy" Tag="{Binding ParsedRequestCode}"
                  Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="8,0,0,0"
                  VerticalAlignment="Top" Click="OnCopyValueClick"/>
        </Grid>
        <Button Content="Continue to issue license" Style="{StaticResource PrimaryButton}" Command="{Binding ProceedCommand}"
                HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="16">
      <TextBlock Text="{Binding Caution}" Style="{StaticResource BodyMuted}" Foreground="{StaticResource TextBrush}"/>
    </Border>
  </StackPanel>
</UserControl>
