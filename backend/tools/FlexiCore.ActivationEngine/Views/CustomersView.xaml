<UserControl x:Class="FlexiCore.ActivationEngine.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlexiCore.ActivationEngine.Views">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22"/>
    <local:StatusBanner/>

    <Border Style="{StaticResource Card}" Padding="40" Visibility="{Binding HasNoRows, Converter={StaticResource BoolToVis}}">
      <StackPanel HorizontalAlignment="Center" MaxWidth="480">
        <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="30"
                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="No customers yet" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center" Margin="0,14,0,6"/>
        <TextBlock Text="A customer appears here after the first license is issued to them. Customers are read from the issue ledger; there is no separate customer database yet."
                   Style="{StaticResource BodyMuted}" TextAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border Padding="22">
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource Card}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasNoRows}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBox Style="{StaticResource InputBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Search customers" ToolTip="Search by customer name"/>
          <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource BodyMuted}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Rows}" MaxHeight="560"
                  AutomationProperties.Name="Customers">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Customer" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
            <DataGridTextColumn Header="Licenses" Binding="{Binding Licenses, Mode=OneWay}" Width="90"/>
            <DataGridTextColumn Header="Active now" Binding="{Binding ActiveNow, Mode=OneWay}" Width="100"/>
            <DataGridTextColumn Header="Last issued" Binding="{Binding LastIssued, Mode=OneWay}" Width="170"/>
            <DataGridTextColumn Header="Latest expiry" Binding="{Binding LatestExpiry, Mode=OneWay}" Width="170"/>
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
