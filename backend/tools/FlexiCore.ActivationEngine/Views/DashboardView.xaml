<UserControl x:Class="FlexiCore.ActivationEngine.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FlexiCore.ActivationEngine.Views">
  <StackPanel>
    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22"/>
    <local:StatusBanner/>

    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,-16,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,16,0">
            <StackPanel>
              <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}"/>
              <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" Margin="0,8,0,6" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Caption}" Style="{StaticResource BodyMuted}"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <WrapPanel Margin="0,22,0,0">
      <Button Content="Import installation request" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"
              Command="{Binding DataContext.GoActivateCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Button Content="Issue a license" Style="{StaticResource PrimaryButton}" Margin="0,0,12,8"
              Command="{Binding DataContext.GoIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
      <Button Content="Manage signing keys" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"
              Command="{Binding DataContext.GoKeysCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </WrapPanel>

    <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="380"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="26" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Recent issuance activity" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>

          <StackPanel HorizontalAlignment="Center" Margin="0,30,0,24" MaxWidth="360"
                      Visibility="{Binding HasNoRecent, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="30"
                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="No licenses issued yet" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
            <TextBlock Text="Import a customer's installation request, then issue a license. Every issued license appears here."
                       Style="{StaticResource BodyMuted}" TextAlignment="Center"/>
          </StackPanel>

          <StackPanel Margin="0,14,0,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Recorded" Style="{StaticResource SectionLabel}"/>
              <TextBlock Grid.Column="1" Text="Customer" Style="{StaticResource SectionLabel}"/>
              <TextBlock Grid.Column="2" Text="License ID" Style="{StaticResource SectionLabel}"/>
              <TextBlock Grid.Column="3" Text="Key" Style="{StaticResource SectionLabel}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding When}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Licensee}" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding LicenseId}" FontSize="13" FontFamily="Consolas"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Grid.Column="3" Text="{Binding KeyId}" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MutedBrush}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="26" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Configuration check" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>
          <TextBlock Text="No configuration problems found." Style="{StaticResource BodyMuted}"
                     Visibility="{Binding HasNoWarnings, Converter={StaticResource BoolToVis}}"/>
          <ItemsControl ItemsSource="{Binding Warnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource WarnBgBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource WarnFgBrush}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource WarnFgBrush}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
