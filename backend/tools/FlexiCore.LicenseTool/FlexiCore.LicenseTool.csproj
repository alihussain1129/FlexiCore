<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>FlexiCore.LicenseTool</AssemblyName>
    <RootNamespace>FlexiCore.LicenseTool</RootNamespace>
  </PropertyGroup>

  <!-- Owner-only tool: no NuGet dependencies on purpose (small supply-chain surface for a signing tool).
       It reuses the Licensing library only for the payload limits and for self-checking what it issues. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FlexiCore.Licensing\FlexiCore.Licensing.csproj" />
  </ItemGroup>

</Project>